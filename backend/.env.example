DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=granitos

# Comma-separated list of allowed frontend origins for CORS.
# Add your production frontend URL alongside localhost when deploying, e.g.:
# CORS_ORIGINS=http://localhost:5173,https://granitos.yourdomain.com
CORS_ORIGINS=http://localhost:5173

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO