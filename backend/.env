# --- Database ---
# Preferred: a single connection string, e.g. from Neon/Supabase.
# Takes priority over the discrete DB_* vars below if both are set.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Fallback: discrete vars, used for local development against a local
# Postgres install (only read if DATABASE_URL is not set).
DB_HOST=localhost
DB_PORT=5432
DB_USER=shreyassapparad
DB_PASSWORD=
DB_NAME=granitos
DB_SSLMODE=prefer

# Comma-separated list of allowed frontend origins for CORS.
# Add your production frontend URL alongside localhost when deploying, e.g.:
# CORS_ORIGINS=http://localhost:5173,https://granitos.yourdomain.com
CORS_ORIGINS=http://localhost:5173

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
